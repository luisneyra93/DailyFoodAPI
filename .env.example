# ─── Aplicación ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=*

# ─── Base de datos (MySQL) ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=DailyFood
# El esquema se versiona con migraciones; nunca activar synchronize.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ─── Autenticación ─────────────────────────────────────────────────────────────
JWT_SECRET=cambia-esto-por-al-menos-32-caracteres-aleatorios
JWT_EXPIRES_IN=1h
JWT_ISSUER=daily-food-api
JWT_AUDIENCE=daily-food-app
# Vigencia del refresh token, en días.
JWT_REFRESH_TTL_DAYS=7
BCRYPT_SALT_ROUNDS=12

# ─── Catálogo de roles ─────────────────────────────────────────────────────────
# Id del rol `Paciente` en la tabla `Roles`.
ROL_PACIENTE_ID=3

# ─── Rate limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
